# Superset Environment Configuration Template
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE CONFIGURATION - POSTGRESQL
# =============================================================================
DATABASE_DIALECT=postgresql
DATABASE_USER=superset
DATABASE_PASSWORD=change_me_strong_password
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset

# PostgreSQL Environment Variables (for Docker Compose)
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=change_me_strong_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CELERY_DB=0
REDIS_CACHE_DB=1
REDIS_RESULTS_DB=2

# =============================================================================
# SUPERSET SECURITY
# =============================================================================
# Generate with: openssl rand -base64 42
SUPERSET__SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET_KEY_GENERATED_WITH_OPENSSL

# JWT secret for async queries (required for GLOBAL_ASYNC_QUERIES feature)
SUPERSET__JWT_SECRET=CHANGE_ME_TO_A_COMPLEX_JWT_SECRET_GENERATED_WITH_OPENSSL

# =============================================================================
# SUPERSET APPLICATION
# =============================================================================
SUPERSET_PORT=8088
SUPERSET_LOG_LEVEL=info
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no

# Celery Configuration
CELERYD_CONCURRENCY=2

# =============================================================================
# DOCKER REGISTRY (for deployment)
# =============================================================================
DOCKER_REGISTRY=europe-west4-docker.pkg.dev/bower-eu-data-warehouse/boie
IMAGE_NAME=superset
IMAGE_TAG=latest

# =============================================================================
# EMAIL CONFIGURATION (for alerts and reports)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=lucas@getbower.com
SMTP_PASSWORD=your_app_specific_password
SMTP_MAIL_FROM=superset@getbower.com

# =============================================================================
# OAUTH CONFIGURATION (Optional)
# =============================================================================
# Google OAuth
GOOGLE_KEY=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_client_secret
OAUTH_HOME_DOMAIN=yourdomain.com

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Mapbox for map visualizations
MAPBOX_API_KEY=your_mapbox_api_key

# Slack for alerts
SLACK_API_TOKEN=your_slack_bot_token

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Data preservation is ALWAYS enabled - no configuration needed
# Your data is automatically protected during all deployments

# =============================================================================
# MONITORING AND PERFORMANCE
# =============================================================================
# Enable/disable features for production
FEATURE_FLAGS='{"ENABLE_TEMPLATE_PROCESSING": true, "GLOBAL_ASYNC_QUERIES": true}'

# Cache configuration
CACHE_CONFIG='{"CACHE_TYPE": "RedisCache", "CACHE_DEFAULT_TIMEOUT": 300, "CACHE_KEY_PREFIX": "superset_"}'

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# This configuration is optimized for production deployment:
# - PostgreSQL: separate container with health checks
# - Redis: separate container with persistence
# - Superset: main application with worker and beat scheduler
# - All services have proper health checks and restart policies
# - Resource limits are configured for production use
#
# For production, ensure you:
# 1. Use strong passwords for all services
# 2. Configure proper SSL/TLS certificates
# 3. Set up proper authentication (OAuth, LDAP, etc.)
# 4. Regular backups of database and configurations
# 5. Monitoring and alerting setup
# 6. Firewall rules and security groups
