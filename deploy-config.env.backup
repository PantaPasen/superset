# Superset Production Deployment Configuration
# Generated for production deployment to bower-superset
# Created on $(date)

# Google Cloud Platform Configuration - PRODUCTION
GCP_PROJECT_ID="bower-eu-data-warehouse"
VM_INSTANCE_NAME="bower-superset"
VM_ZONE="europe-north1-a"
VM_PROJECT_PATH="/root/superset"
VM_USER="root"

# Docker Registry Configuration
DOCKER_REGISTRY="europe-west4-docker.pkg.dev/bower-eu-data-warehouse/boie"
IMAGE_NAME="superset"
IMAGE_TAG="$(date +%Y%m%d-%H%M%S)"

# Build Configuration
DOCKER_PLATFORM="linux/amd64"  # Ensures x86_64 compatibility
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
SUPERSET_BUILD_TARGET="dev"  # Use 'dev' for full features or 'lean' for minimal

# Build Optimization Flags
INCLUDE_CHROMIUM="false"
INCLUDE_FIREFOX="false"
BUILD_TRANSLATIONS="false"
DEV_MODE="false"

# Production Deployment Configuration
BACKUP_ENABLED="true"                    # ALWAYS enabled for production
HEALTH_CHECK_ENABLED="true"              # ALWAYS enabled for production
PRESERVE_DATA="true"                     # ALWAYS enabled - data is never destroyed
EXTERNAL_IP=""                           # Leave empty to auto-detect

# Database Configuration (for health checks and backups)
POSTGRES_USER="superset"
POSTGRES_DB="superset"
POSTGRES_PASSWORD="superset"

# Docker Compose Environment Variables (to prevent warnings)
CYPRESS_CONFIG=""
SUPERSET_LOG_LEVEL="info"
SUPERSET_LOAD_EXAMPLES="no"
CELERYD_CONCURRENCY="2"

# Production Security (SECRET_KEY)
SUPERSET__SECRET_KEY="RPhXZEcRZN0y_N2-jgxykOEZ1E1V9JUffP8BGk-V447-9evnlTxnYlwPvlVHzukW9shiocXM6SGaiuqfkrx-pQ"

# Superset Configuration - PRODUCTION
SUPERSET_PORT="8088"
SUPERSET_ADMIN_USER="admin"
SUPERSET_ADMIN_EMAIL="lucas@getbower.com"

# Production Security Settings
# Note: Actual secrets should be in .env file on the VM, not in this config
# This config file is for deployment parameters only

# Production Monitoring and Alerting
MONITORING_ENABLED="true"
ALERTING_ENABLED="true"

# Backup Configuration
BACKUP_RETENTION_DAYS="30"               # Keep backups for 30 days
BACKUP_LOCATION="../superset-backups"    # Relative to project path on VM

# Production Performance Settings
SUPERSET_WORKERS="4"                     # Number of Celery workers
REDIS_MAX_MEMORY="512mb"                 # Redis memory limit
POSTGRES_SHARED_BUFFERS="256MB"          # PostgreSQL memory settings

# SSL/TLS Configuration (nginx with Let's Encrypt)
SSL_ENABLED="true"                       # SSL certificates configured and working
SSL_CERT_PATH="/etc/nginx/ssl/cert.pem"
SSL_KEY_PATH="/etc/nginx/ssl/key.pem"
DOMAIN_NAME="superset.getbower.com"      # Custom domain with HTTPS access
SSL_CERT_EXPIRES="2025-11-18"            # Let's Encrypt certificate expiration

# Production Logging
LOG_LEVEL="INFO"                         # INFO for production, DEBUG for troubleshooting
LOG_RETENTION_DAYS="14"                  # Keep logs for 14 days

# Feature Flags for Production
FEATURE_FLAGS_ALERT_REPORTS="true"
FEATURE_FLAGS_DASHBOARD_NATIVE_FILTERS="true"
FEATURE_FLAGS_GLOBAL_ASYNC_QUERIES="true"

# Production Environment Validation
ENVIRONMENT="production"
DEPLOYMENT_TYPE="vm_production"

# Rollback Configuration
ROLLBACK_ENABLED="true"                  # Enable rollback capabilities
ROLLBACK_BACKUP_COUNT="3"                # Keep last 3 backups for rollback

# Health Check Configuration
HEALTH_CHECK_TIMEOUT="300"               # 5 minutes timeout for health checks
HEALTH_CHECK_RETRIES="10"                # Number of health check retries
HEALTH_CHECK_INTERVAL="30"               # Seconds between health checks

# Production Deployment Notes
# =============================================================================
# This configuration is specifically for production deployment to:
# - VM Instance: bower-superset
# - Zone: europe-north1-a
# - Project: bower-eu-data-warehouse
#
# Key Production Features:
# 1. ✅ Comprehensive backup before deployment
# 2. ✅ Zero-downtime deployment with data preservation
# 3. ✅ Health checks and monitoring
# 4. ✅ Rollback capabilities
# 5. ✅ Production-optimized resource settings
#
# Security Notes:
# - SECRET_KEY and other secrets are managed via .env on the VM
# - This file contains deployment parameters only, not secrets
# - SSL/TLS should be configured separately when ready
#
# Usage:
# 1. Run backup: ./backup-production.sh
# 2. Deploy: ./deploy-production.sh
# 3. Verify: Check health endpoints and data integrity
# =============================================================================
