# Apache Superset Modern Configuration Environment Variables - SIMPLIFIED DEPLOYMENT
# All services (PostgreSQL, Redis, Superset) run in the same container
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE CONFIGURATION - LOCAL POSTGRESQL
# =============================================================================
DATABASE_DIALECT=postgresql
DATABASE_USER=superset
DATABASE_PASSWORD=change_me_strong_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=superset

# Examples database (same PostgreSQL instance)
EXAMPLES_USER=superset
EXAMPLES_PASSWORD=change_me_strong_password
EXAMPLES_HOST=localhost
EXAMPLES_PORT=5432
EXAMPLES_DB=examples

# =============================================================================
# REDIS CONFIGURATION - LOCAL REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CELERY_DB=0
REDIS_CACHE_DB=1
REDIS_RESULTS_DB=2

# =============================================================================
# SUPERSET SECURITY
# =============================================================================
# Generate with: openssl rand -base64 42
SUPERSET__SECRET_KEY=CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET_KEY_GENERATED_WITH_OPENSSL

# JWT secret for async queries (required for GLOBAL_ASYNC_QUERIES feature)
SUPERSET__JWT_SECRET=CHANGE_ME_TO_A_COMPLEX_JWT_SECRET_GENERATED_WITH_OPENSSL

# =============================================================================
# SUPERSET APPLICATION
# =============================================================================
SUPERSET_PORT=8088
SUPERSET_LOG_LEVEL=INFO
SUPERSET_ENV=development

# Load example data on first run (set to true if desired)
LOAD_EXAMPLES=false

# =============================================================================
# EMAIL CONFIGURATION (for alerts and reports)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_app_specific_password
SMTP_MAIL_FROM=superset@yourdomain.com

# =============================================================================
# OAUTH CONFIGURATION (Optional)
# =============================================================================
# Google OAuth
GOOGLE_KEY=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_client_secret
OAUTH_HOME_DOMAIN=yourdomain.com

# Azure OAuth (if using)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Mapbox for map visualizations
MAPBOX_API_KEY=your_mapbox_api_key

# Slack for alerts
SLACK_API_TOKEN=your_slack_bot_token

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# Grafana password for monitoring dashboard
GRAFANA_PASSWORD=admin

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# This simplified configuration runs all services in a single container:
# - PostgreSQL: localhost:5432
# - Redis: localhost:6379  
# - Superset: localhost:8088
# - Celery Worker: background process
# - Celery Beat: background process
#
# All services are managed by Supervisor within the container
# Data is persisted using Docker volumes
#
# For production, consider:
# 1. Using strong passwords
# 2. Enabling HTTPS
# 3. Setting up proper authentication
# 4. Regular backups
# 5. Monitoring and alerting 

# =============================================================================
# SUPERSET ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to your deployment directory and customize the values
# Use this with docker-compose or Kubernetes deployments

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate strong secrets in production using:
# openssl rand -base64 42

# Main application secret key
SUPERSET__SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-OPENSSL-RAND-BASE64-42

# JWT secret for async queries (required for GLOBAL_ASYNC_QUERIES feature)
SUPERSET__JWT_SECRET=CHANGE-ME-IN-PRODUCTION-JWT-SECRET-USE-OPENSSL-RAND-BASE64-42 